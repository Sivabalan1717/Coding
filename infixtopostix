class Solution:
    def infixToPrefix(self, s):
        def precedence(op):
            if op == '^':
                return 3
            elif op in ('*', '/'):
                return 2
            elif op in ('+', '-'):
                return 1
            return 0

        # Reverse expression
        s = s[::-1]

        # Swap brackets
        s = ''.join(
            ')' if ch == '(' else '(' if ch == ')' else ch
            for ch in s
        )

        stack = []
        result = []

        for ch in s:

            # Operand
            if ch.isalnum():
                result.append(ch)

            # Opening bracket
            elif ch == '(':
                stack.append(ch)

            # Closing bracket
            elif ch == ')':
                while stack and stack[-1] != '(':
                    result.append(stack.pop())

                if stack:
                    stack.pop()

            # Operator
            else:
                while (
                    stack
                    and stack[-1] != '('
                    and (
                        precedence(stack[-1]) > precedence(ch)
                        or (
                            precedence(stack[-1]) == precedence(ch)
                            and ch == '^'
                        )
                    )
                ):
                    result.append(stack.pop())

                stack.append(ch)

        # Pop remaining operators
        while stack:
            result.append(stack.pop())

        # Reverse postfix → prefix
        return ''.join(result[::-1])
