class Solution(object):
    def singleNonDuplicate(self, nums):
        l = 0
        r = len(nums) - 1

        while l < r:
            m = (l + r) // 2

            if m % 2 == 1:
                m -= 1

            if nums[m] == nums[m + 1]:
                l = m + 2
            else:
                r = m

        return nums[l]

class Solution(object):
    def moveZeroes(self, nums):
        """
        :type nums: List[int]
        :rtype: None Do not return anything, modify nums in-place instead.
        """
        i=0
        for j in range(len(nums)):
            if nums[j]!=0:
                nums[i], nums[j]= nums[j],nums[i]
                i+=1
