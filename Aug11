class Solution(object):
    def sortedSquares(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        
        i = 0
        n= len(nums)
        j=  n-1
        res= [0]*n
        for a in range(n-1, -1,-1):
            if (abs(nums[i])<abs(nums[j])):
                res[a]=nums[j]*nums[j]
                j-= 1
            else:
                res[a]=nums[i]*nums[i]
                i+=1
        return res
                
            
