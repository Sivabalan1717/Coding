class Solution(object):
    def subArrayRanges(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        total = 0

        for i in range(len(nums)):
            mini = nums[i]
            maxi = nums[i]

            for j in range(i, len(nums)):
                mini = min(mini, nums[j])
                maxi = max(maxi, nums[j])

                total += maxi - mini

        return total
