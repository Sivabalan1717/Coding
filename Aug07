class Solution(object):
    def findDisappearedNumbers(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        for num in nums:
            ind= abs(num)-1
            nums[ind]= - abs(nums[ind])
        re = [ ]  
        for i in range (len(nums)):
            if nums[i]> 0:
                re.append(i+1)

        return re
